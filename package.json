{
  "name": "nativeskill",
  "version": "0.3.0",
  "description": "Meaning-first localization checks and locale profiles for NativeSkill",
  "license": "MIT",
  "type": "module",
  "engines": {"node": ">=22.20.0"},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kamaleshkabeerdoss/nativeskill.git"
  },
  "bin": {"nativeskill": "packages/cli/src/cli.mjs"},
  "files": [
    "packages/cli/src",
    "skills/nativeskill/assets",
    "skills/nativeskill/licenses",
    "skills/nativeskill/scripts",
    "skills/nativeskill/LICENSE-UNICODE.txt",
    "skills/nativeskill/THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test packages/cli/test/*.test.mjs skills/nativeskill/scripts/*.test.mjs evals/real-world/*/*.test.mjs",
    "import:wording": "node scripts/import-wording.mjs",
    "generate:locales": "node scripts/generate-locales.mjs"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "2.11.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {"cldr-core": "49.0.0"}
}
