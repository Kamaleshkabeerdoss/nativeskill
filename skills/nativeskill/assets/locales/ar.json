,"source":{"id":"reference-only","url":"https://github.com/DrKLO/Telegram/blob/21f7d109da6ab3506c9e9577f98c6a38771ab335/TMessagesProj/src/main/res/values/strings.xml"}},{"locale":"ar","script":"Arab","concept":"billing.payment_pending","role":"status","text":"الدفع قيد الانتظار","status":"draft","note":"Unreviewed draft. The payment has no final outcome. Not source-attested.","source":{"id":"reference-only","url":"https://github.com/DrKLO/Telegram/blob/21f7d109da6ab3506c9e9577f98c6a38771ab335/TMessagesProj/src/main/res/values/strings.xml"}},{"locale":"ar","script":"Arab","concept":"billing.go_to_payment","role":"button","text":"الانتقال إلى الدفع","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Opens the payment step. It does not charge the user.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.payment_declined","role":"status","text":"تم رفض الدفع","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. The provider declined the payment. Do not invent a reason.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.retry_payment","role":"button","text":"إعادة محاولة الدفع","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Starts another payment attempt.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.cancel_payment","role":"button","text":"إلغاء عملية الدفع هذه","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Cancels this payment attempt. It does not stop later renewals.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.end_subscription_now","role":"button","text":"إنهاء الاشتراك الآن","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Ends access now. Does not promise a refund.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.refund_requested","role":"status","text":"تم تقديم طلب الاسترداد","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. The request is recorded. The money is not necessarily back.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.refund_completed","role":"status","text":"اكتمل الاسترداد","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. The refund has completed. Keep the amount and destination when the app provides them.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"auth.resend_code","role":"button","text":"إعادة إرسال الرمز","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Sends another code. Does not say the previous code still works.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"auth.code_expired","role":"status","text":"انتهت صلاحية الرمز","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. The code expired. That is different from a wrong code.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"form.save_draft","role":"button","text":"حفظ المسودة","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. MSA. Unpublished draft.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"form.discard_changes","role":"button","text":"تجاهل التغييرات","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Unsaved edits only.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"item.delete_permanently","role":"button","text":"حذف نهائي","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Irreversible.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"content.download","role":"button","text":"تنزيل","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Download. تحميل often means upload or load.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"search.clear_filters","role":"button","text":"مسح عوامل التصفية","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Filters only.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.discount_savings","role":"label","text":"وفّر {amount}","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Keep {amount}.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"auth.change_password","role":"button","text":"تغيير كلمة المرور","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Signed-in change. The same words were removed from the GPL catalog and are a draft here.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"item.add","role":"button","text":"إضافة","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Adds to the collection. Verbal noun, natural on an Arabic button.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"billing.pay_now","role":"button","text":"ادفع الآن","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Core UI draft for the style-guide locale.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"ar","script":"Arab","concept":"dialog.dismiss","role":"button","text":"إغلاق","status":"draft","note":"Preferred Close (draft). Nominal, so no gender is chosen.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"},"preferred":true},{"locale":"ar","script":"Arab","concept":"crm.sales_leads","role":"navigation-label","text":"العم