/skills/nativeskill/assets/concepts.json"}},{"locale":"hi","script":"Deva","concept":"auth.code_expired","role":"status","text":"यह कोड समाप्त हो गया","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. The code expired. That is different from a wrong code.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"hi","script":"Deva","concept":"form.save_draft","role":"button","text":"मसौदा सहेजें","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Unpublished. आप form.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"hi","script":"Deva","concept":"form.discard_changes","role":"button","text":"बदलाव छोड़ें","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Unsaved edits.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"hi","script":"Deva","concept":"item.delete_permanently","role":"button","text":"हमेशा के लिए मिटाएँ","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. Irreversible.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"hi","script":"Deva","concept":"content.download","role":"button","text":"डाउनलोड करें","status":"draft","note":"Unreviewed draft. Not source-attested and not a native-speaker review. The English loan is what Hindi UI uses for this action.","source":{"id":"reference-only","url":"https://github.com/Kamaleshkabeerdoss/nativeskill/blob/main/skills/nativeskill/assets/concepts.json"}},{"locale":"hi","script":"Deva","concept":"search.clear_filters","role":"button","te